  <script>
    /* ----------------------------------------------------
       State & Constants
       ---------------------------------------------------- */
    let currentUnit = 'feet'; // 'feet' or 'metres'
    const BASE_RATE_PER_SQFT = 110;
    const METRE_TO_FEET_FACTOR = 3.28084; // 1 metre = 3.28084 ft

    /* ----------------------------------------------------
       Header Scroll Transition & Mobile Menu
       ---------------------------------------------------- */
    const siteHeader = document.getElementById('site-header');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');

    window.addEventListener('scroll', () => {
      if (window.scrollY > 40) {
        siteHeader.classList.add('glass-nav', 'shadow-lg');
      } else {
        siteHeader.classList.remove('glass-nav', 'shadow-lg');
      }
    });

    function toggleMobileMenu() {
      mobileMenu.classList.toggle('hidden');
    }

    if (mobileMenuBtn) {
      mobileMenuBtn.addEventListener('click', toggleMobileMenu);
    }

    document.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', () => {
        if (!mobileMenu.classList.contains('hidden')) {
          mobileMenu.classList.add('hidden');
        }
      });
    });

    /* ----------------------------------------------------
       Interactive Product Comparison Slider Logic
       ---------------------------------------------------- */
    const comparisonContainer = document.getElementById('comparison-container');
    const conventionalLayer = document.getElementById('conventional-layer');
    const sliderHandle = document.getElementById('slider-handle');
    const conventionalImgWrapper = document.getElementById('conventional-img-wrapper');

    let isSliding = false;

    function updateSlider(positionX) {
      if (!comparisonContainer) return;
      const rect = comparisonContainer.getBoundingClientRect();
      let offsetX = positionX - rect.left;
      if (offsetX < 0) offsetX = 0;
      if (offsetX > rect.width) offsetX = rect.width;
      
      const percentage = (offsetX / rect.width) * 100;
      conventionalLayer.style.width = `${percentage}%`;
      sliderHandle.style.left = `${percentage}%`;
      sliderHandle.setAttribute('aria-valuenow', Math.round(percentage));

      // Match internal image dimension to container width
      if (conventionalImgWrapper) {
        conventionalImgWrapper.style.width = `${rect.width}px`;
      }
    }

    if (comparisonContainer && sliderHandle) {
      // Sync on resize
      window.addEventListener('resize', () => {
        const rect = comparisonContainer.getBoundingClientRect();
        if (conventionalImgWrapper) {
          conventionalImgWrapper.style.width = `${rect.width}px`;
        }
      });

      // Mouse Events
      comparisonContainer.addEventListener('mousedown', (e) => {
        isSliding = true;
        updateSlider(e.clientX);
      });
      window.addEventListener('mouseup', () => {
        isSliding = false;
      });
      window.addEventListener('mousemove', (e) => {
        if (!isSliding) return;
        updateSlider(e.clientX);
      });

      // Touch Events for Mobile
      comparisonContainer.addEventListener('touchstart', (e) => {
        isSliding = true;
        if (e.touches[0]) updateSlider(e.touches[0].clientX);
      }, { passive: true });
      window.addEventListener('touchend', () => {
        isSliding = false;
      });
      window.addEventListener('touchmove', (e) => {
        if (!isSliding) return;
        if (e.touches[0]) updateSlider(e.touches[0].clientX);
      }, { passive: true });

      // Keyboard Accessibility for Slider
      sliderHandle.addEventListener('keydown', (e) => {
        const currentVal = parseInt(sliderHandle.getAttribute('aria-valuenow') || '50', 10);
        const rect = comparisonContainer.getBoundingClientRect();
        if (e.key === 'ArrowLeft') {
          const newVal = Math.max(0, currentVal - 5);
          updateSlider(rect.left + (rect.width * newVal / 100));
        } else if (e.key === 'ArrowRight') {
          const newVal = Math.min(100, currentVal + 5);
          updateSlider(rect.left + (rect.width * newVal / 100));
        }
      });
    }

    /* ----------------------------------------------------
       Estimate Calculator Logic
       ---------------------------------------------------- */
    function setMeasurementUnit(unit) {
      currentUnit = unit;
      const ftBtn = document.getElementById('unit-ft-btn');
      const mBtn = document.getElementById('unit-m-btn');
      const unitLabels = document.querySelectorAll('.unit-label');

      if (unit === 'feet') {
        ftBtn.className = 'px-4 py-1.5 rounded-lg text-xs font-bold uppercase tracking-wider bg-brand-red text-white transition-colors';
        mBtn.className = 'px-4 py-1.5 rounded-lg text-xs font-bold uppercase tracking-wider text-gray-400 hover:text-white transition-colors';
        unitLabels.forEach(el => el.textContent = 'ft');
      } else {
        mBtn.className = 'px-4 py-1.5 rounded-lg text-xs font-bold uppercase tracking-wider bg-brand-red text-white transition-colors';
        ftBtn.className = 'px-4 py-1.5 rounded-lg text-xs font-bold uppercase tracking-wider text-gray-400 hover:text-white transition-colors';
        unitLabels.forEach(el => el.textContent = 'm');
      }
      calculateTotalEstimate();
    }

    function addOpeningRow() {
      const container = document.getElementById('openings-list');
      const rowCount = container.querySelectorAll('.opening-row').length + 1;
      const unitTxt = currentUnit === 'feet' ? 'ft' : 'm';
      const defaultW = currentUnit === 'feet' ? '8' : '2.4';
      const defaultH = currentUnit === 'feet' ? '5' : '1.5';

      const div = document.createElement('div');
      div.className = 'opening-row bg-brand-obsidian/60 p-4 rounded-2xl border border-white/10 grid grid-cols-1 sm:grid-cols-12 gap-3 items-center';
      div.dataset.row = rowCount;
      div.innerHTML = `
        <div class="sm:col-span-3">
          <label class="block text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Opening Label</label>
          <input type="text" value="Opening ${rowCount}" class="opening-name w-full bg-white/5 border border-white/15 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-brand-red">
        </div>
        <div class="sm:col-span-3">
          <label class="block text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Width (<span class="unit-label">${unitTxt}</span>)</label>
          <input type="number" min="0.5" step="0.1" value="${defaultW}" class="opening-width w-full bg-white/5 border border-white/15 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-brand-red" oninput="calculateTotalEstimate()">
        </div>
        <div class="sm:col-span-3">
          <label class="block text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Height (<span class="unit-label">${unitTxt}</span>)</label>
          <input type="number" min="0.5" step="0.1" value="${defaultH}" class="opening-height w-full bg-white/5 border border-white/15 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-brand-red" oninput="calculateTotalEstimate()">
        </div>
        <div class="sm:col-span-2 text-right sm:text-center">
          <span class="block text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-1">Area</span>
          <span class="text-sm font-bold text-rose-200 opening-subtotal">-- sq.ft</span>
        </div>
        <div class="sm:col-span-1 text-right">
          <button type="button" onclick="removeOpeningRow(this)" aria-label="Remove opening" class="p-2 text-gray-400 hover:text-rose-400 transition-colors">
            ✕
          </button>
        </div>
      `;
      container.appendChild(div);
      calculateTotalEstimate();
    }

    function removeOpeningRow(btn) {
      const container = document.getElementById('openings-list');
      const rows = container.querySelectorAll('.opening-row');
      if (rows.length <= 1) {
        // Clear instead of removing last row
        const row = rows[0];
        row.querySelector('.opening-width').value = '0';
        row.querySelector('.opening-height').value = '0';
      } else {
        btn.closest('.opening-row').remove();
      }
      calculateTotalEstimate();
    }

    function calculateTotalEstimate() {
      const rows = document.querySelectorAll('.opening-row');
      let totalSqFt = 0;

      rows.forEach(row => {
        const w = parseFloat(row.querySelector('.opening-width').value) || 0;
        const h = parseFloat(row.querySelector('.opening-height').value) || 0;
        let rowSqFt = 0;

        if (currentUnit === 'metres') {
          // Convert metres to feet for area calculation
          const wFt = w * METRE_TO_FEET_FACTOR;
          const hFt = h * METRE_TO_FEET_FACTOR;
          rowSqFt = wFt * hFt;
        } else {
          rowSqFt = w * h;
        }

        totalSqFt += rowSqFt;
        const subtotalEl = row.querySelector('.opening-subtotal');
        if (subtotalEl) {
          subtotalEl.textContent = `${rowSqFt.toFixed(1)} sq.ft`;
        }
      });

      const displayArea = document.getElementById('display-total-area');
      const displayPrice = document.getElementById('display-total-price');

      displayArea.textContent = totalSqFt.toFixed(1);
      const estPrice = Math.round(totalSqFt * BASE_RATE_PER_SQFT);
      displayPrice.textContent = `₹${estPrice.toLocaleString('en-IN')}*`;

      return { totalSqFt: totalSqFt.toFixed(1), estPrice };
    }

    function sendCalculatedQuoteToWhatsApp() {
      const { totalSqFt, estPrice } = calculateTotalEstimate();
      const rows = document.querySelectorAll('.opening-row');
      let breakdown = [];

      rows.forEach((row, idx) => {
        const name = row.querySelector('.opening-name').value || `Opening ${idx + 1}`;
        const w = row.querySelector('.opening-width').value || '0';
        const h = row.querySelector('.opening-height').value || '0';
        const unit = currentUnit === 'feet' ? 'ft' : 'm';
        breakdown.push(`${name}: ${w}x${h} ${unit}`);
      });

      const message = `Hi THEO NETS, I used your website calculator for an invisible grill estimate.
Project Dimensions:
